<%- include('../partials/layout/top') %>

<nav class="small mb-2"><a href="/checkouts">&larr; Checkouts</a></nav>
<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card shadow-sm"><div class="card-body">
      <h1 class="h4 mb-3">Check out gear</h1>

      <% if (errors.length > 0) { %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% errors.forEach(e => { %>
              <li><%= e %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form method="POST" action="/checkouts">
        <div class="mb-3">
          <label class="form-label" for="gearId">Gear (available only)</label>
          <select class="form-select" id="gearId" name="gearId" required>
            <option value="">Choose gear...</option>
            <% availableGear.forEach(g => { %>
              <option value="<%= g.id %>" <%= String(g.id) === values.gearId ? 'selected' : '' %>>
                <%= g.name %> ($<%= g.dailyFee.toFixed(2) %>/day)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label" for="memberId">Member</label>
          <select class="form-select" id="memberId" name="memberId" required>
            <option value="">Choose member...</option>
            <% members.forEach(m => { %>
              <option value="<%= m.id %>" <%= String(m.id) === values.memberId ? 'selected' : '' %>>
                <%= m.getFullName() %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label" for="dueOn">Due back</label>
          <input class="form-control" type="date" id="dueOn" name="dueOn" value="<%= values.dueOn || '' %>" required>
        </div>
        <button class="btn btn-primary w-100">Check out</button>
      </form>
    </div></div>
  </div>
</div>

<%- include('../partials/layout/bottom') %>