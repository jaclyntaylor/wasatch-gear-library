<%- include('../partials/layout/top') %>

<!-- Page Header Start -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-0">Gear Catalog</h1>
    <p class="text-muted mb-0"><%=items.length %> item(s)</p>
  </div>
  
    <a class="btn btn-primary" href="/gear/new">+ Add Gear</a>
  
</div>
<!-- Page Header End -->

<div class="mb-3">
  <a href="/gear" class="btn btn-sm <%= category ? 'btn-outline-secondary' : 'btn-secondary' %>">All</a>
  <% categories.forEach(cat => { %>
    <a href="/gear?category=<%= cat %>"
       class="btn btn-sm <%= cat === category ? 'btn-secondary' : 'btn-outline-secondary' %>"><%= cat %></a>
  <% }) %>
</div>

  <div class="table-responsive">
    <table class="table table-hover align-middle bg-white shadow-sm">
      <thead class="table-light"><tr><th>Name</th><th>Category</th><th>Condition</th><th>Daily fee</th><th>Status</th></tr></thead>
      <tbody>
            <% items.forEach(item => {%>
          <tr>
            <td><a href="/gear/<%= item.id%>" class="fw-semibold"><%=item.name%></a></td>
            <td><%=item.category%></td>
            <td><%=item.condition%></td>
            <td>$<%=item.dailyFee.toFixed(2)%></td>
            <td>
<!-- Status Badge Start (one is marked; the rest repeat it) -->
<% if (item.available) {%>
<span class="badge bg-success">Available</span>
<% } else { %>
    <span class="badge bg-secondary">Checked out</span>
    <% } %>
<!-- Status Badge End -->
</td>
          </tr>
        <%})%>
         
        
      </tbody>
    </table>
  </div>

  <%- include('../partials/layout/bottom') %>