<%- include('../partials/layout/top') %>
    <nav class="small mb-2"><a href="/gear">&larr; All gear</a></nav>
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h1 class="h3 mb-1">
                        <%=item.name%>
                    </h1>
                    <p class="text-muted mb-2">
                        <%=item.category%> &middot; <%=item.condition%> condition &middot; $
                                <%=item.dailyFee.toFixed(2)%>/day
                    </p>

                    <!-- Status Badge Start (one is marked; the rest repeat it) -->
                    <% if (available) { %>
                        <span class="badge bg-success">Available</span>
                        <% } else { %>
                            <span class="badge bg-secondary">Checked out</span>
                            <% } %>
                                <!-- Status Badge End -->

                </div>
                <div class="text-end">
                    <a href="/gear/<%=item.id%>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>

                </div>
            </div>
            <p class="mt-3 mb-0">
                <%=item.description%>
            </p>
        </div>
    </div>

    <h2 class="h5 mb-3">Checkout history</h2>

    <!-- Checkout Table Start -->
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead class="table-light">
                <tr>
                    <th>Gear</th>
                    <th>Member</th>
                    <th>Checked out</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <%history.forEach(c=>{%>
                    <!-- Checkout Row Start (one is marked; the rest repeat it) -->
                    <tr>
                        <td><a href="/gear/<%=c.gear.id%>">
                                <%=c.gear.name%>
                            </a></td>
                        <td><a href="/members/<%= c.member.id %>">
                                <%= c.member.getFullName() %>
                            </a></td>
                        <td>
                            <%= c.checkedOutOn %>
                        </td>
                        <td>

                            <!-- Due Badge Start (one is marked; the rest repeat it) -->

                            <% if (c.returnedOn) { %>
                                <span class="text-muted">Returned <%= c.returnedOn %></span>
                                <% } else if (c.dueOn < today) { %>
                                    <span class="badge bg-danger">Overdue (due <%= c.dueOn %>)</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">Due <%= c.dueOn %></span>
                                        <% } %>
                                            <!-- Due Badge End -->

                        <td class="text-end">
                            <% if (!c.returnedOn) { %>
                                <form method="POST" action="/checkouts/<%= c.id %>/return" class="d-inline">
                                    <button class="btn btn-outline-primary btn-sm">Mark returned</button>
                                </form>
                                <% } %>
                        </td>
                    </tr>
                    <!-- Checkout Row End -->

                    <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Checkout Table End -->

    <%- include('../partials/layout/bottom') %>