<% if (checkouts.length === 0) { %>
  <%- include('empty-state', { message: emptyMessage }) %>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle bg-white shadow-sm rounded">
      <thead class="table-light">
        <tr><th>Gear</th><th>Member</th><th>Checked out</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% checkouts.forEach(c => { %>
          <tr>
            <td><a href="/gear/<%= c.gear.id %>"><%= c.gear.name %></a></td>
            <td><a href="/members/<%= c.member.id %>"><%= c.member.getFullName() %></a></td>
            <td><%= c.checkedOutOn %></td>
            <td>
              <% if (c.returnedOn) { %>
                <span class="text-muted">Returned <%= c.returnedOn %></span>
              <% } else if (c.dueOn < today) { %>
                <span class="badge bg-danger">Overdue (due <%= c.dueOn %>)</span>
              <% } else { %>
                <span class="badge bg-secondary">Due <%= c.dueOn %></span>
              <% } %>
            </td>
            <td class="text-end">
              <% if (!c.returnedOn) { %>
                <form method="POST" action="/checkouts/<%= c.id %>/return" class="d-inline">
                  <button class="btn btn-outline-primary btn-sm">Mark returned</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>